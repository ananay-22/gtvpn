module(
    name = "gtvpn",
    version = "0.5.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.0.0", repo_name = "rules_python_bzlmod")
bazel_dep(name = "protobuf", version = "31.1", repo_name = "com_google_protobuf")
bazel_dep(name = "toolchains_protoc", version = "0.6.1")
bazel_dep(name = "apple_support", version = "2.6.1", repo_name = "build_bazel_apple_support")
bazel_dep(name = "toolchains_llvm", version = "1.9.0")
bazel_dep(name = "rules_foreign_cc", version = "0.13.0")
bazel_dep(name = "make", version = "4.4.1.bcr.3")
bazel_dep(name = "openssl", version = "3.5.8.bcr.2")
bazel_dep(name = "libxml2", version = "2.15.3")
bazel_dep(name = "zlib", version = "1.3.2", repo_name = "bcr_zlib")

bazel_dep(name = "multi_platforms", version = "0.1.0")
local_path_override(
    module_name = "multi_platforms",
    path = "Tools/rules_multi_platforms",
)

bazel_dep(name = "pyapp", version = "0.1.0")
local_path_override(
    module_name = "pyapp",
    path = "Tools/rules_pyapp",
)

python = use_extension("@rules_python_bzlmod//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(version = "v31.1")
use_repo(protoc, "toolchains_protoc_hub")

register_toolchains(
    "@toolchains_protoc_hub//:all",
    "//Toolchains/Protobuf:python_toolchain",
)

sysroot_archive = use_repo_rule("//Toolchains/Linux:defs.bzl", "sysroot_archive")

sysroot_archive(
    name = "sysroot_linux_x86_64",
    arch = "x86_64",
    version = "bullseye",
)

sysroot_archive(
    name = "sysroot_linux_aarch64",
    arch = "aarch64",
    version = "bullseye",
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_linux_x86_64",
    cxx_standard = {"": "c++20"},
    exec_arch = "x86_64",
    exec_os = "linux",
    llvm_version = "19.1.7",
    stdlib = {"": "builtin-libc++"},
)
llvm.sysroot(
    name = "llvm_linux_x86_64",
    label = "@sysroot_linux_x86_64//:sysroot",
    targets = ["linux-x86_64"],
)
llvm.toolchain(
    name = "llvm_linux_aarch64",
    cxx_standard = {"": "c++20"},
    exec_arch = "aarch64",
    exec_os = "linux",
    llvm_version = "19.1.7",
    stdlib = {"": "builtin-libc++"},
)
llvm.sysroot(
    name = "llvm_linux_aarch64",
    label = "@sysroot_linux_aarch64//:sysroot",
    targets = ["linux-aarch64"],
)
use_repo(llvm, "llvm_linux_aarch64", "llvm_linux_x86_64")

register_toolchains(
    "//Toolchains/Linux:linux_aarch64",
    "//Toolchains/Linux:linux_x86_64",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

SOURCES = 'filegroup(name = "srcs", srcs = glob(["**"]), visibility = ["//visibility:public"])\n'

http_archive(
    name = "openconnect_src",
    build_file_content = SOURCES,
    sha256 = "5b32369467db6e5f317aa1ed12cfcbb81ed00bdbc765450b6bfcbdc300944a58",
    strip_prefix = "openconnect-9.21",
    urls = ["https://www.infradead.org/openconnect/download/openconnect-9.21.tar.gz"],
)

http_archive(
    name = "foreign_cc_pkgconfig_src",
    build_file_content = SOURCES,
    patches = ["//Toolchains/ForeignCc/Patches:pkgconfig_glib_int_conversion.diff"],
    sha256 = "6fc69c01688c9458a57eb9a1664c9aba372ccda420a02bf4429fe610e7e7d591",
    strip_prefix = "pkg-config-0.29.2",
    urls = ["https://pkgconfig.freedesktop.org/releases/pkg-config-0.29.2.tar.gz"],
)

register_toolchains(
    "//Toolchains/ForeignCc:make",
    "//Toolchains/ForeignCc:pkgconfig",
)

UV = "https://github.com/astral-sh/uv/releases/download/0.12.18/"

http_file(
    name = "uv_linux_x86_64",
    downloaded_file_path = "uv-x86_64-unknown-linux-musl.tar.gz",
    sha256 = "e38d97460b98ebfd31b197de0fe9fa578add4bc8ba0179b203dd3f87b99f98e6",
    urls = [UV + "uv-x86_64-unknown-linux-musl.tar.gz"],
)

http_file(
    name = "uv_linux_aarch64",
    downloaded_file_path = "uv-aarch64-unknown-linux-musl.tar.gz",
    sha256 = "0796973fb3eea8095078c3d0659bd17a5f6789a71b8dd85caff2483178f78ac3",
    urls = [UV + "uv-aarch64-unknown-linux-musl.tar.gz"],
)

http_file(
    name = "uv_macos_arm64",
    downloaded_file_path = "uv-aarch64-apple-darwin.tar.gz",
    sha256 = "cf40e0c6a202190ccd9e0406dcfdd5b2d6668a9a5c779b17948963df32aafe5b",
    urls = [UV + "uv-aarch64-apple-darwin.tar.gz"],
)

http_file(
    name = "uv_macos_x86_64",
    downloaded_file_path = "uv-x86_64-apple-darwin.tar.gz",
    sha256 = "2e4108f5395397c8bc5d43bf83d3bdbb2d0e92b90d0efa607756be704905fa33",
    urls = [UV + "uv-x86_64-apple-darwin.tar.gz"],
)

pyapp = use_extension("@pyapp//:extensions.bzl", "pyapp")
pyapp.uv(
    archive = "@uv_linux_x86_64//file:uv-x86_64-unknown-linux-musl.tar.gz",
    platform = "linux_x86_64",
    strip_prefix = "uv-x86_64-unknown-linux-musl",
)
pyapp.uv(
    archive = "@uv_linux_aarch64//file:uv-aarch64-unknown-linux-musl.tar.gz",
    platform = "linux_aarch64",
    strip_prefix = "uv-aarch64-unknown-linux-musl",
)
pyapp.uv(
    archive = "@uv_macos_arm64//file:uv-aarch64-apple-darwin.tar.gz",
    platform = "macos_arm64",
    strip_prefix = "uv-aarch64-apple-darwin",
)
pyapp.uv(
    archive = "@uv_macos_x86_64//file:uv-x86_64-apple-darwin.tar.gz",
    platform = "macos_x86_64",
    strip_prefix = "uv-x86_64-apple-darwin",
)
pyapp.lock(
    name = "gtvpn_lock",
    python_version = "3.11",
    src = "//Utilities/GtVpn:requirements_lock.txt",
)
use_repo(pyapp, "gtvpn_lock")
