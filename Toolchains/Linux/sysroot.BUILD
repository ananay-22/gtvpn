package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sysroot",
    srcs = glob([
        "usr/include/**",
        "usr/local/include/**",
        "lib/*-linux-gnu*/**",
        "lib64/**",
        "usr/lib/*-linux-gnu*/**",
        "usr/lib/gcc/**",
        "usr/lib64/**",
    ]),
)
